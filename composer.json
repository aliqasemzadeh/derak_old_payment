{
    "name": "aliqasemzadeh/bap",
    "type": "project",
    "description": "Laravel Base Admin Panel.",
    "keywords": ["admin", "BAP", "framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0|^8.1",
        "akaunting/laravel-firewall": "^2.0",
        "alajusticia/laravel-expirable": "^1.6",
        "aliqasemzadeh/bsc-php": "^3.0",
        "aliqasemzadeh/livewire-bootstrap-modal": "dev-master",
        "arcanedev/log-viewer": "^9.0",
        "beyondcode/laravel-websockets": "^1.13",
        "codenix-sv/coingecko-api": "^1.0",
        "creativeorange/gravatar": "^1.0",
        "cybercog/laravel-ban": "^4.7",
        "ffsoft-foss/tron-sdk": "4.0.1.6",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "irfa/php-sn-generator": "^1.1",
        "jantinnerezo/livewire-alert": "^2.2",
        "kornrunner/ethereum-address": "^0.3.0",
        "kornrunner/keccak": "^1.1",
        "laravel/framework": "^9.2",
        "laravel/jetstream": "^2.6",
        "laravel/sanctum": "^2.14",
        "laravel/tinker": "^2.7",
        "league/commonmark": "^2.0",
        "livewire/livewire": "^2.5",
        "maatwebsite/excel": "^3.1",
        "mcamara/laravel-localization": "^1.7",
        "morilog/jalali": "^3.2",
        "nesbot/carbon": "^2.54",
        "protonlabs/bitcoin": "^1.0",
        "questocat/laravel-referral": "^1.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.5",
        "spatie/laravel-medialibrary": "^10.1",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-tags": "^4.3",
        "symfony/dotenv": "^6.2",
        "tucker-eric/eloquentfilter": "^3.0",
        "web3p/web3.php": "dev-master",
        "yadahan/laravel-authentication-log": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "knuckleswtf/scribe": "^4.14",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nascent-africa/jetstrap": "^2.5",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
